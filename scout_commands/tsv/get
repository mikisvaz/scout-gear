#!/usr/bin/env ruby

require 'scout'

$0 = "scout #{$previous_commands.any? ? $previous_commands*" " + " " : "" }#{ File.basename(__FILE__) }" if $previous_commands

# Port of rbbt-util share/rbbt_commands/tsv/get. Adaptation: scout's
# TSV::Parser#initialize takes strict keywords, so only :fix/:header_hash/:sep/:type
# are forwarded to it (legacy passed the whole options hash; :key_field etc.
# would raise ArgumentError in scout). key_field is still honored via the
# traverse call. Otherwise behavior identical.

options = SOPT.setup <<EOF

Query a TSV value

$ #{$0} [<options>] <filename.tsv|-> [<key>]

Use - to read from STDIN, 'key' can be the key string or a number representing
its position. If not specified 'key' defaults to 0, the first entry.

-tch--tokyocabinet File is a tokyocabinet hash database
-tcb--tokyocabinet_bd File is a tokyocabinet B database
-f--fields* Fields to extract
-s--sep* Separation character
-hh--header_hash* Change the character used to mark the header line (defaults to #)
-k--key_field* Use this field as key
-h--help Print this help
-l--lines Separate in lines
-t--type* Type of tsv
EOF
if options[:help]
  if defined? scout_usage
    scout_usage
  else
    puts SOPT.doc
  end
  exit 0
end

file, key = ARGV

raise MissingParameterException.new :file if file.nil?

file = STDIN if file == '-'

if options[:tokyocabinet] || options[:tokyocabinet_bd]
  begin
    require 'tokyocabinet'
  rescue LoadError
    raise ParameterException, "The 'tokyocabinet' gem is not available; install it with 'gem install tokyocabinet' to use -tch/-tcb"
  end
end

case
when options[:tokyocabinet]
  tsv = Persist.open_tokyocabinet(file, false)
when options[:tokyocabinet_bd]
  tsv = Persist.open_tokyocabinet(file, false, nil, TokyoCabinet::BDB)
else
  if String === file
    file = file.dup
    Path.setup(File.expand_path(file))
  end
  tsv = file
end

fields = options[:fields]
key_field = options[:key_field]
fields = fields.split(/[,|]/, -1) unless fields.nil?

if TSV === tsv
  case key
  when nil
    key = tsv.keys.first if key.nil?
  when /^\d+$/
    key = tsv.keys[key.to_i] unless tsv.include?(key)
  end

  v = tsv[key]

  fields ||= tsv.fields
  puts Log.color(:blue, "Key: #{ key }")
  if fields
    if fields.length == 1
      if options[:lines]
        puts (Array === v ? v.flatten*"\n" : v.to_s )
      else
        puts (Array === v ? v.flatten*"\t" : v.to_s )
      end
    else
      fields.zip(v).each do |field,v|
        puts "#{Log.color :magenta, field+":"} #{v}"
      end
    end
  else
    puts "#{Log.color :magenta, "value:"} #{v}"
  end
  exit
end

options = IndiferentHash.setup(options.dup)
options.keys_to_sym!

parser = TSV::Parser.new tsv, **options.slice(:fix, :header_hash, :sep, :type)
fields ||= parser.fields
i = 0
TSV.traverse(parser, :key_field => key_field, :fields => fields, :type => options[:type]) do |k,v|
  if key == "#{i}"
    key = Array === k ? k.first : k
  elsif key.nil?
    key = k.first
  end
  i += 1
  next unless k == key
  k = k.first if Array === k
  puts Log.color(:blue, "Key: #{ k }")
  if fields
    if fields.length == 1
      if options[:lines]
        puts (Array === v ? v.flatten*"\n" : v.to_s )
      else
        puts (Array === v ? v.flatten*"\t" : v.to_s )
      end
    else
      fields.zip(v).each do |field,v|
        puts "#{Log.color :magenta, field+":"} #{v}"
      end
    end
  else
    puts "#{Log.color :magenta, "value:"} #{Misc.fingerprint v}"
  end
end
