#!/usr/bin/env ruby

require 'scout'

# Port of rbbt-util share/rbbt_commands/tsv/slice. Fixed stale legacy
# help ("Display summary informations" -> slice description) and the
# legacy TC-branch bug: it printed `tsv.summary` (copy-paste from info);
# the port prints the sliced TSV through tsv.slice, consistent with the
# file branch.

$0 = "scout #{$previous_commands.any? ? $previous_commands*" " + " " : "" }#{ File.basename(__FILE__) }" if $previous_commands

options = SOPT.setup <<EOF
Slice fields (columns) from a TSV file

$ #{$0} [<options>] file.tsv -f "Field 1,Field 2"

Extract only the given fields. Works with Tokyocabinet HDB and BDB as well.

-tch--tokyocabinet File is a TC HDB
-tcb--tokyocabinet_bd File is a TC BDB
-hh--header_hash* Change the character used to mark the header line (defaults to #)
-f--fields* Field to slice (comma-separated)
-h--help Help
EOF
if options[:help]
  if defined? scout_usage
    scout_usage
  else
    puts SOPT.doc
  end
  exit 0
end

file = ARGV.shift

file = case file
       when "-"
         STDIN
       when String
         Open.open(file)
       else
         raise MissingParameterException.new :file if file.nil?
       end

fields = options[:fields]
raise ParameterException, "Please specify the fields to slice" if fields.nil?

options.keys_to_sym!

if options[:tokyocabinet] || options[:tokyocabinet_bd]
  begin
    require 'tokyocabinet'
  rescue LoadError
    raise ParameterException, "The 'tokyocabinet' gem is not available; install it with 'gem install tokyocabinet' to use -tch/-tcb"
  end
end

case
when options[:tokyocabinet]
  tsv = Persist.open_tokyocabinet(file, false)
  puts tsv.slice(fields.split(","))
when options[:tokyocabinet_bd]
  tsv = Persist.open_tokyocabinet(file, false, nil, TokyoCabinet::BDB)
  puts tsv.slice(fields.split(","))
else
  stream = TSV.traverse file, **options.merge(:into => :stream, :type => :list, :fields => fields.split(","), :unnamed => true) do |k,fields,names|
    [k,fields].flatten * "\t"
  end
  puts stream.read
  exit 0
end
