#!/usr/bin/env ruby

require 'scout'

# Port of rbbt-util share/rbbt_commands/tsv/transpose. Fixed stale
# legacy help ("Display summary informations" -> transpose
# description). Behavior otherwise identical.

$0 = "scout #{$previous_commands.any? ? $previous_commands*" " + " " : "" }#{ File.basename(__FILE__) }" if $previous_commands

options = SOPT.setup <<EOF
Transpose TSV

$ #{$0} [<options>] file.tsv

Use the rows as fields and the fields as rows, turning the given field
(-f) into the key field of the transposed TSV. Works with Tokyocabinet
HDB and BDB as well.

-tch--tokyocabinet File is a TC HDB
-tcb--tokyocabinet_bd File is a TC BDB
-f--field* Field name for key
-hh--header_hash* Change the character used to mark the header line (defaults to #)
-h--help Help
EOF
if options[:help]
  if defined? scout_usage
    scout_usage
  else
    puts SOPT.doc
  end
  exit 0
end

file = ARGV.shift

file = case file
       when "-"
         STDIN
       when String
         Open.open(file)
       else
         raise MissingParameterException.new :file if file.nil?
       end

options[:header_hash] ||= options.delete "header_hash"
options.delete :header_hash if options[:header_hash].nil?

field = options.delete :field

options.keys_to_sym!

if options[:tokyocabinet] || options[:tokyocabinet_bd]
  begin
    require 'tokyocabinet'
  rescue LoadError
    raise ParameterException, "The 'tokyocabinet' gem is not available; install it with 'gem install tokyocabinet' to use -tch/-tcb"
  end
end

case
when options[:tokyocabinet]
  tsv = Persist.open_tokyocabinet(file, false)
when options[:tokyocabinet_bd]
  tsv = Persist.open_tokyocabinet(file, false, nil, TokyoCabinet::BDB)
else
  tsv = TSV.open(file, options.merge(:type => :list))
end

puts tsv.transpose(field).to_s
